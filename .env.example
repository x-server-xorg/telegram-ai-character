# ===== Telegram =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# ID админов (через запятую). Если заданы — команда /forget доступна только им.
# Пусто = команда доступна всем участникам.
ADMIN_IDS=

# ===== DeepSeek =====
# web     — «редирект веб-чата» chat.deepseek.com напрямую (нужен DEEPSEEK_TOKEN)
# official— официальный api.deepseek.com (нужен DEEPSEEK_API_KEY)
# proxy   — любой OpenAI-совместимый прокси поверх веб-чата (deepseek2api и т.п.)
DEEPSEEK_MODE=web

# Токен веб-чата DeepSeek (нужен только для DEEPSEEK_MODE=web)
# Как получить: chat.deepseek.com -> F12 -> Application -> Local Storage -> ключ userToken
# (либо вкладка Network -> запрос .../chat/completion -> заголовок authorization: Bearer ...)
DEEPSEEK_TOKEN=

# Опционально: cookie-заголовок (например ds_session_id=...), если токена одного не хватает
DEEPSEEK_COOKIE=

# Для DEEPSEEK_MODE=official
DEEPSEEK_API_KEY=

# Для DEEPSEEK_MODE=proxy (OpenAI-совместимый base URL)
DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1
DEEPSEEK_MODEL=deepseek-chat

# Режим "размышления" (только для DEEPSEEK_MODE=web): 1 = включить DeepThink
DEEPSEEK_THINKING=0

# ===== Память диалога =====
# Потолок одного запроса к ИИ (инструкция + сообщение), символов.
# История хранится в постоянной сессии DeepSeek + архиве messages.jsonl,
# здесь просто защита от гигантских вставок.
MAX_CONTEXT_CHARS=100000
# Слова-триггеры для ответа в группах (через запятую, без @)
TRIGGER_WORDS=
# Максимум символов в ответе ИИ
MAX_REPLY_CHARS=3500
# Таймаут одного запроса к ИИ, сек
AI_TIMEOUT=180
TEMPERATURE=0.9
